# Production / Compose smoke — copy to .env.production and fill secrets.
# Do not commit real .env.production.

NODE_ENV=production
PORT=3000

# Must match Postgres service credentials (compose.yaml defaults shown).
DATABASE_URL=postgres://loom:loom@postgres:5432/loom_crm

# Required. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret

# UI origin(s). For nginx on :8080 same-host, browser origin is http://<host>:8080
CORS_ORIGIN=http://localhost:8080

# Optional first-admin seed (created only if email does not exist yet)
SEED_ADMIN_EMAIL=admin@loom.local
SEED_ADMIN_PASSWORD=replace-with-strong-password
