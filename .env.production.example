# Production / VPS — copy to .env.production and fill secrets.
# Do not commit real .env.production.
#
# Used by: docker compose --env-file .env.production (interpolation + container env)
# Project isolation: always pass -p loom-crm (wrappers do this; do not rely on COMPOSE_PROJECT_NAME alone).

NODE_ENV=production
PORT=3000

# Postgres role/db (must match DATABASE_URL user/password/db)
POSTGRES_USER=loom
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=loom_crm

# Internal URL as seen from Compose network (host = service name "postgres")
DATABASE_URL=postgres://loom:replace-with-strong-db-password@postgres:5432/loom_crm

# Required. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret

# Public origin after go_live (nginx on :80, same-host)
CORS_ORIGIN=http://localhost

# Optional first-admin seed (only creates if email does not exist yet).
# After restoring a PW snapshot, SeedService typically does nothing — use CUTOVER_SMOKE_* below.
SEED_ADMIN_EMAIL=admin@loom.local
SEED_ADMIN_PASSWORD=replace-with-strong-password

# Automated site smoke login (production-only secrets). NOT the same SoT as SEED_ADMIN_*.
# Use a real user that exists in the restored/imported DB. Never put real values in this example.
CUTOVER_SMOKE_EMAIL=
CUTOVER_SMOKE_PASSWORD=

# Optional: host path to PW SQLite for --refresh-from-pw / cutover profile (read-only mount)
# PW_SQLITE_HOST_PATH=/root/ProjectWeekend/runtime/data/app.sqlite
