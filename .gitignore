# Dependencies
node_modules/
.pnpm-store/

# Build
dist/
build/
tmp/
out-tsc/
.angular/
*.tsbuildinfo

# Env & secrets
.env
.env.local
.env.production
.env.*.local
!.env.example
!.env.production.example

# Logs & OS
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test / coverage
coverage/
.nyc_output/

# ProjectWeekend is a local read-only copy-source (separate git repo).
# Never commit it into LoomCRM.
/ProjectWeekend/

# Local data / live DB dumps. Commit DB state only via explicit snapshot:
#   scripts/db-snapshot.ps1 → data/app.snapshot.sql
# Live Postgres (Compose volume / local) is never tracked.
data/**
!data/app.snapshot.sql
*.sqlite
*.sqlite-*
cutover-report-*.json

# Docker volumes
.docker-data/
